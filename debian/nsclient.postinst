#!/bin/sh
set -e

#DEBHELPER#

# nsclient.ini may hold credentials (NRPE/NSCA/check_mk passwords, etc.), so
# restrict it to root:nsclient 0640: the group the daemon runs as can read it,
# others cannot. This must stay after the debhelper-generated snippets above,
# whose sysusers call creates the "nsclient" group the chown needs (and never
# write the literal debhelper token in a comment: dh_installdeb substitutes
# every occurrence of it). As cups/ssl-cert do, reapply on every configure
# unless the admin registered a dpkg-statoverride for the file (see
# README.Debian).
if [ "$1" = "configure" ] && [ -f /etc/nsclient/nsclient.ini ] \
   && ! dpkg-statoverride --list /etc/nsclient/nsclient.ini >/dev/null 2>&1; then
    chown root:nsclient /etc/nsclient/nsclient.ini
    chmod 0640 /etc/nsclient/nsclient.ini
fi
