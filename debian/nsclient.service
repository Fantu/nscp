[Unit]
Description=NSClient++ Monitoring Agent
Documentation=https://nsclient.org/docs/
After=network.target

[Service]
Type=simple
User=nsclient
Group=nsclient
# systemd creates and owns the log directory for the service user before
# start, so the package does not ship it.
LogsDirectory=nsclient
LogsDirectoryMode=0750
WorkingDirectory=/usr/lib/nsclient
# No pid file: with Type=simple systemd tracks the main process itself, and
# nscp only writes one when --pid is passed (nothing would read it; even the
# logrotate snippet uses copytruncate instead of signalling the daemon).
ExecStart=/usr/sbin/nscp service --log-backend threaded-file --run

# Hardening, as in upstream's unit: only directives that leave the agent's
# view of the system unchanged.
#
# Deliberately not set. Add them with "systemctl edit nsclient" if the
# trade-off suits this host (do not edit this file: upgrades replace it):
#  - ProtectSystem=, ProtectHome=, PrivateTmp=: they give the service its own
#    mount namespace, whose bind mounts show up in the agent's /proc/mounts.
#    check_drivesize then reports /usr, /etc and /boot as extra read-only
#    drives, check_mount sees them "ro", check_disk_write fails outside
#    ReadWritePaths=, and checks over /tmp read a private copy.
#  - NoNewPrivileges=, CapabilityBoundingSet=, a restrictive
#    SystemCallFilter=: they break external scripts that switch account with
#    "sudo -n -u <user>", the way upstream documents it on Unix.
#
# ProtectKernel* remount /proc/sys, /sys and /usr/lib/modules read-only; none
# of them is reported as a drive, only "check_mount mount=/sys" shows "ro".
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

# Files the agent creates (nsclient.db, the fleet state) are not
# world-readable. Inherited by the external scripts it runs: a script that
# writes a file for another account to read must set the mode itself.
UMask=0027

[Install]
WantedBy=multi-user.target
